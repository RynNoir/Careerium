# Salin ke .env.local lalu isi. JANGAN commit .env.local.
# Jangan pernah memakai awalan NEXT_PUBLIC_ untuk kunci API atau token database.

GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=            # salin ID model persis dari Google AI Studio, jangan menebak
GROQ_API_KEY=
TURSO_DATABASE_URL=      # kosong saat development -> file:local.db
TURSO_AUTH_TOKEN=
SESSION_SECRET=          # minimal 32 karakter acak, contoh: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
